NODE_ENV=production

# Render injects PORT automatically. Set a fallback for local development.
PORT=10000

# Public Render service URL, e.g. https://your-service.onrender.com
BASE_URL=

# Telegram bot tokens
USER_BOT_TOKEN=
ADMIN_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Admin Telegram IDs, comma-separated
ADMIN_IDS=

# MongoDB connection string
MONGO_URI=

# Memory API (Mem0)
MEM0_API_KEY=

# AI Provider (OpenAI-compatible)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional: AI_BASE_URL=https://api.openai.com/v1

# Web search API
TAVILY_API_KEY=

# News search API
NEWSDATA_API_KEY=

# Security
JWT_SECRET=
ENCRYPTION_KEY=

# Limits
MAX_HISTORY_MESSAGES=12
RATE_LIMIT=20
